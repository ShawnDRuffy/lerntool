{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ereignisse/1",
  "type": "object",
  "properties": {
    "format": {
      "const": "ereignisse/1",
      "description": "Formatkennung.",
      "examples": [
        "ereignisse/1"
      ]
    },
    "sitzung": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4; zugleich Dateiname ohne .json.",
      "examples": [
        "5f0c9a12-3b44-4d8e-9a10-7c2b1e00a111"
      ]
    },
    "geraet": {
      "enum": [
        "iphone",
        "ipad",
        "laptop",
        "chat-ki"
      ],
      "description": "Schreiber dieser Sitzung.",
      "examples": [
        "iphone"
      ]
    },
    "einheit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Einheit oder null bei Dashboard-Aktion.",
      "examples": [
        "demo-2026-11-17-abend"
      ]
    },
    "einheit_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Passende Fassung oder zusammen mit einheit null.",
      "examples": [
        1
      ]
    },
    "timer": {
      "anyOf": [
        {
          "enum": [
            "25/5",
            "45/10"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Timer dieser Sitzung.",
      "examples": [
        "25/5"
      ]
    },
    "regler_wiederholung": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Regler dieser Sitzung.",
      "examples": [
        0.5
      ]
    },
    "demo": {
      "type": "boolean",
      "description": "Demo-Ereignisse dürfen keinen echten Lernstand ändern.",
      "examples": [
        true
      ]
    },
    "ereignisse": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ereignis"
      },
      "minItems": 1,
      "description": "Chronologische Ereignisliste; nur dieser Schreiber hängt an."
    },
    "geraet_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stabile zufällige Geräte-ID, optional für alte Ereignisdateien."
    }
  },
  "required": [
    "format",
    "sitzung",
    "geraet",
    "einheit",
    "einheit_version",
    "demo",
    "ereignisse"
